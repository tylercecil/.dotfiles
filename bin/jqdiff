#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
	echo "Usage: $0 <file1> <file2> <jq statement>"
	echo "  This will apply the same jq statement to both files, and diff the output."
	exit 1
}

if [[ $# -ne 3 ]]; then
	usage
fi

F1="${1}"
F2="${2}"
JQS="${3}"

delta -s <(jq -S "${JQS}" "${F1}") <(jq -S "${JQS}" "${F2}")
